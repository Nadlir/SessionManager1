# Google Sheet that holds the Diversa data (the id is the long token in the sheet URL)
GOOGLE_SHEET_ID=

# Service account credentials from the Google Cloud JSON key file
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Tab that holds both the sessions (A:F) and the patient list (AA)
SHEET_TAB=MainSheet

PORT=8787
